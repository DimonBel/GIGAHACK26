# The variables setup.sh writes to automation/.env (mode 600); it generates every empty value.
# .env holds secrets: it is gitignored, never commit it. Hashes are bcrypt, single-quoted so Docker Compose
# leaves their $ signs alone; empty one (or the token) and re-run setup.sh for a new secret.

# Shared secret: the backend reads it from this file and sends it as the X-Secure-MOM-Token header;
# setup.sh stores it in n8n as the webhook's Header Auth credential.
SECURE_MOM_N8N_TOKEN=

# n8n editor login at http://127.0.0.1:5678. Only the hash is kept: setup.sh shows a new password once.
N8N_OWNER_EMAIL=admin@secure-mom.local
N8N_OWNER_PASSWORD_HASH=

# MailHog inbox and API login at http://127.0.0.1:8025 (basic auth; the smoke test uses it too).
MAILHOG_USER=secure-mom
MAILHOG_PASSWORD=
MAILHOG_PASSWORD_HASH=
