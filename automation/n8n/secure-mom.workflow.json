    {
      "id": "c46dcaca-7b37-4b40-86ef-6c2d4355e1c9",
      "name": "400 unknown meeting type",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [900, 400],
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\n  \"detail\": \"meeting_type must be medical, executive or administrative\"\n}",
        "options": {
          "responseCode": 400
        }
      }
    },
    {
      "id": "57fcffe6-5895-4434-8e1b-bc0925fe285f",
      "name": "Compose email",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1120, 0],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "1f6f3c1e-8d0a-4c47-9a57-2c1f0b6d9e11",
              "name": "from",
              "value": "={{ $json.body.from }}",
              "type": "string"
            },
            {
              "id": "2a7e4d2f-9e1b-4d58-8b68-3d2a1c7e0f22",
              "name": "to",
              "value": "={{ $json.body.to.join(', ') }}",
              "type": "string"
            },
            {
              "id": "3b8f5e30-af2c-4e69-9c79-4e3b2d8f1a33",
              "name": "cc",
              "value": "={{ ($json.body.cc ?? []).join(', ') }}",
              "type": "string"
            },
            {
              "id": "4c906f41-b03d-4f7a-8d8a-5f4c3e902b44",
              "name": "subject",
              "value": "={{ $json.body.subject.startsWith($json.subject_prefix) ? $json.body.subject : $json.subject_prefix + ' ' + $json.body.subject }}",
              "type": "string"
            },
            {
              "id": "5da17052-c14e-4a8b-9e9b-6a5d4fa13c55",
              "name": "text",
              "value": "={{ $json.body.text + '\\n\\n-- \\n' + $json.footer }}",
              "type": "string"
            },
            {
              "id": "6eb28163-d25f-4b9c-8fac-7b6e50b24d66",
              "name": "html",
              "value": "={{ $json.body.html.replace(/<\\/body>|$/i, '<hr><p style=\"color:#555;font-size:12px\">' + $json.footer + '</p>$&') }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "7fc39274-e36a-4cad-b0b1-8c7f61c35e77",
      "name": "Send email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [1340, 0],
      "onError": "continueErrorOutput",
      "credentials": {
        "smtp": {
          "id": "secureMomSmtp001",
          "name": "MailHog SMTP"
        }
      },
      "parameters": {
        "fromEmail": "={{ $json.from }}",
        "toEmail": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "emailFormat": "both",
        "text": "={{ $json.text }}",
        "html": "={{ $json.html }}",
        "options": {
          "appendAttribution": false,
          "ccEmail": "={{ $json.cc }}"
        }
      }
    },
    {
      "id": "80d4a385-f47b-4dbe-a2c2-9d8072d46f88",
      "name": "200 sent",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [1560, -100],
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\n  \"sent\": true\n}",
        "options": {
          "responseCode": 200
        }
      }
    },
    {
      "id": "91e5b496-058c-4ecf-b3d3-ae9183e57a99",
      "name": "502 mail server failed",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [1560, 100],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ sent: false, detail: 'mail server error: ' + $json.error }) }}",
        "options": {
          "responseCode": 502
        }
      }
    }
  ],
  "connections": {
