              "name": "subject_prefix",
              "value": "[Executive]",
              "type": "string"
            },
            {
              "id": "95d01fd6-a24e-48e1-8732-fdbbc5069164",
              "name": "footer",
              "value": "Executive meeting minutes, approved by the moderator and sent by Secure MOM. Confidential: for the management team only.",
              "type": "string"
            }
          ]
